        <mxCell id="cGhBEv_HtNmtMj92sC4k-267" value="MQTT connection" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=26.7;fontColor=#333333;fontStyle=1;align=left;spacing=3.8;strokeOpacity=0;fillOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=2.3;lucidId=Qd1gjvP03Yqw;" parent="cGhBEv_HtNmtMj92sC4k-1" vertex="1">
          <mxGeometry x="75" y="-840" width="300" height="71" as="geometry" />
        </mxCell>
        <mxCell id="cGhBEv_HtNmtMj92sC4k-268" value="We want to emit a LWT message on a topic when this service goes offline/online. The topic to use is from mqtt.availability_topic in the config. The message should be &#39;online&#39; if the service is online and &#39;offline&#39; if the service is offline." style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=16.6;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#99d5ca;strokeWidth=0;lucidId=Qd1gAMBQdDcm;" parent="cGhBEv_HtNmtMj92sC4k-1" vertex="1">
          <mxGeometry x="75" y="-717" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cGhBEv_HtNmtMj92sC4k-269" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.6px;&quot;&gt;This can be specified in the connect string. .e.g. &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#007020;font-weight: bold;&quot;&gt;var&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; mqtt    &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; require(&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;mqtt&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;); &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#007020;font-weight: bold;&quot;&gt;var&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; client  &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; mqtt.connect(&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;mqtt://broker.mqttdashboard.com&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,{   will&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; {     topic&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;dynalite/available&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,     payload; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#4070a0;&quot;&gt;&#39;offline&#39;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,     qos&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#40a070;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;,     retain&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#666666;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#007020;font-weight: bold;&quot;&gt;true&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;color:#555555;&quot;&gt;   } });&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#99d5ca;strokeWidth=0;lucidId=Qd1gtcQQ4~sz;" parent="cGhBEv_HtNmtMj92sC4k-1" vertex="1">
          <mxGeometry x="315" y="-717" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cGhBEv_HtNmtMj92sC4k-270" value="LWT message (an online/offline status)" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=26.7;fontColor=#333333;align=left;spacing=3.8;verticalAlign=middle;strokeOpacity=0;fillOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=2.3;lucidId=Qd1gUsZY_Hwx;" parent="cGhBEv_HtNmtMj92sC4k-1" vertex="1">
          <mxGeometry x="75" y="-788" width="952" height="71" as="geometry" />
        </mxCell>
        <mxCell id="cGhBEv_HtNmtMj92sC4k-271" value="As soon as the connection is made, publish a &#39;online&#39; message to the mqtt.availability_topic topic. If this service crashes, the &#39;offline&#39; message will be published automatically." style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=16.6;fontStyle=2;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#99d5ca;strokeWidth=0;lucidId=Qd1gQ2QQJqml;" parent="cGhBEv_HtNmtMj92sC4k-1" vertex="1">
