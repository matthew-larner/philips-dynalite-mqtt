        <mxCell id="cGhBEv_HtNmtMj92sC4k-75" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;[28,area,channel-1,113,channel_level,fade,255,checksum]&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;Where:&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;- fade is channel.fade x 10 floated e.g. 2.3 -&amp;gt; 23&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;- channel_level calculated as:&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;If brightness exists -&amp;gt; channel_level=255-brightness then force channel_level above 0 i.e. if 0 -&amp;gt; 1 (channel_level should be in the range of 1-255)&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;ELSE&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;if ON -&amp;gt; channel_level=1&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;if OFF -&amp;gt; channel_level=255&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="strokeColor=none;fillColor=none;overflow=visible;whiteSpace=wrap;html=1;fontFamily=Arimo;spacing=0;strokeOpacity=10