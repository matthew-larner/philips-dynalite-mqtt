&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;- area is the area number for this light&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;- channel is the channel where&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-weight: bold;font-family: Arimo;&quot;&gt; channel=&#39;blue&#39;&lt;/span&gt; for the group of channels for this rgbw light&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;- fade is channel.fade x 10 floated e.g. 2.3 -&amp;gt; 23&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:13px;font-family: Arimo;&quot;&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-weight: bold;font-family: Arimo;&quot;&gt;- channel_level calculated as:&lt;/span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;channel_level=255- (&lt;/span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-weight: bold;font-family: Arimo;&quot;&gt;{blue} &lt;/span&gt;* brightness/255) &#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.5px;color:#666600;font-family: Arimo;&quot;&gt;then force channel_level above 0 i.e. if 0 -&amp;gt; 1 (channel_level should be in the range of 1-255), rounded to an integer.&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;" style="strokeColor=none;fillColor=none;overflow=visible;whiteSpace=wrap;html=1;fontFamily=Arimo;spacing=0;strokeOpacity=100;fillOpacity=100;strokeWidth=2;fontSize=13;" parent="cGhBEv_HtNmtMj92sC4k-368" vertex="1">
