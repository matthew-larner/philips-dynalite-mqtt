        <mxCell id="cGhBEv_HtNmtMj92sC4k-273" value="" style="shape=stencil(UzV2Ls5ILEhVNTIoLinKz04tz0wpyVA1dlE1MsrMy0gtyiwBslSNXVWNndPyi1LTi/JL81Ig/IJEkEoQKze/DGRCBUSfAUiHkUElMs8NojAnMw9JoaWpnpEJsYoNDVDNNTTSMyVBtQEeo8lWiqIQyECESFpmTg4kQJHl0UMQKAQJfWNXAA==);whiteSpace=wrap;overflow=block;blockSpacing=1;html=1;strokeColor=#d6b656;strokeOpacity=100;fillOpacity=100;fillColor=#fff2cc;strokeWidth=2;fontSize=13;spacing=0;" parent="cGhBEv_HtNmtMj92sC4k-272" vertex="1">
